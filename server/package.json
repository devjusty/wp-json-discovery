{
  "name": "wp-json-discovery-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prestart": "pnpm --filter @wp-json-discovery/contracts run build",
    "start": "node src/index.ts",
    "pretest": "pnpm --filter @wp-json-discovery/contracts run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "pretypecheck": "pnpm --filter @wp-json-discovery/contracts run build",
    "typecheck": "tsc -p tsconfig.json",
    "db:inspect": "node src/db/inspect.js",
    "db:assets": "node src/db/list-assets.js",
    "db:import:logs": "node src/db/import-logs.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@wp-json-discovery/contracts": "workspace:*",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "morgan": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
